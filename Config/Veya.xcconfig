// Veya app target; inherits Shared.xcconfig through the project configs.
PRODUCT_BUNDLE_IDENTIFIER = $(VEYA_BUNDLE_ID_PREFIX).Veya
PRODUCT_NAME = $(TARGET_NAME)
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
LD_RUNPATH_SEARCH_PATHS = @executable_path/../Frameworks

SWIFT_EMIT_LOC_STRINGS = YES
STRING_CATALOG_GENERATE_SYMBOLS = YES
GENERATE_INFOPLIST_FILE = YES
ENABLE_PREVIEWS = YES
CODE_SIGN_STYLE = Automatic

ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = YES
ENABLE_OUTGOING_NETWORK_CONNECTIONS = YES
// Spotify Connect zeroconf discovery runs a local HTTP listener.
ENABLE_INCOMING_NETWORK_CONNECTIONS = YES
// Help > Export Diagnostics saves through NSSavePanel.
ENABLE_USER_SELECTED_FILES = readwrite
